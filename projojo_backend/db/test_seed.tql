insert

    # PF-task-002d portfolio seed reset contract:
    # Reset deterministic E2E data with: task test:e2e:reset
    # Direct backend/container reset command: uv run python db/reset_test_database.py --seed db/test_seed.tql
    # Verify portfolio seed fixtures with: task test:e2e:run:selective CLI_ARGS="--paths features/pf-task-002d-portfolio-seed-fixtures-and-reset-contract.feature"

    # Identity providers required by schema for local development users
    $provider_google isa oauthProvider,
        has name "google";

    $provider_github isa oauthProvider,
        has name "github";

    $provider_microsoft isa oauthProvider,
        has name "microsoft";

    # Neutral infrastructure users
    $teacher isa teacher,
        has id "20000000-0000-4000-8000-000000000001",
        has email "teacher.e2e@projojo.local",
        has fullName "Tessa Testdocent",
        has imagePath "default.svg";

    $student isa student,
        has id "20000000-0000-4000-8000-000000000002",
        has email "student.e2e@projojo.local",
        has fullName "Tom Teststudent",
        has imagePath "default.svg",
        has description "Neutrale student voor de lokale E2E infrastructuur proof suite.",
        has portfolioSummary "Portfolio seed student with deterministic completed evidence fixtures.",
        has portfolioSlug "portfolio-seed-world-public",
        has isPortfolioWorldPublic true;

    $portfolio_private_student isa student,
        has id "20000000-0000-4000-8000-000000000005",
        has email "portfolio.private.student@projojo.local",
        has fullName "Priya Priveportfolio",
        has imagePath "default.svg",
        has portfolioSummary "Private-by-default portfolio slug fixture.",
        has portfolioSlug "portfolio-seed-private",
        has isPortfolioWorldPublic false;

    $supervisor isa supervisor,
        has id "20000000-0000-4000-8000-000000000003",
        has email "supervisor.e2e@projojo.local",
        has fullName "Sanne Testbegeleider",
        has imagePath "default.svg";

    $portfolio_unrelated_supervisor isa supervisor,
        has id "20000000-0000-4000-8000-000000000004",
        has email "portfolio.unrelated.supervisor@projojo.local",
        has fullName "Umar Onverwant",
        has imagePath "default.svg";

    # Required auth links
    $teacher_auth isa oauthAuthentication (user: $teacher, provider: $provider_microsoft),
        has oauthSub "e2e-teacher-microsoft-sub";

    $student_auth isa oauthAuthentication (user: $student, provider: $provider_google),
        has oauthSub "e2e-student-google-sub";

    $portfolio_private_student_auth isa oauthAuthentication (user: $portfolio_private_student, provider: $provider_google),
        has oauthSub "portfolio-private-student-google-sub";

    $supervisor_auth isa oauthAuthentication (user: $supervisor, provider: $provider_github),
        has oauthSub "e2e-supervisor-github-sub";

    $portfolio_unrelated_supervisor_auth isa oauthAuthentication (user: $portfolio_unrelated_supervisor, provider: $provider_github),
        has oauthSub "portfolio-unrelated-supervisor-github-sub";

    # Dedicated deterministic business and project marker for preflight + suite assertions
    $business isa business,
        has id "30000000-0000-4000-8000-000000000001",
        has name "E2E Infrastructure Business",
        has description "Neutrale organisatie voor de Projojo E2E infrastructuur proof suite.",
        has imagePath "default.svg",
        has location "Arnhem",
        has sector "Education",
        has companySize "1-10",
        has website "https://example.invalid/projojo-e2e";

    $portfolio_unrelated_business isa business,
        has id "30000000-0000-4000-8000-000000000002",
        has name "Portfolio Unrelated Business",
        has description "Organisatie zonder portfolio-relatie met de deterministische seed student.",
        has imagePath "default.svg",
        has location "Nijmegen",
        has sector "Education",
        has companySize "1-10",
        has website "https://example.invalid/projojo-portfolio-unrelated";

    $portfolio_archived_source_business isa business,
        has id "30000000-0000-4000-8000-000000000003",
        has name "Portfolio Archived Source Business",
        has description "Gearchiveerde bronorganisatie voor deterministische portfolio-context.",
        has imagePath "default.svg",
        has location "Arnhem",
        has sector "Education",
        has companySize "1-10",
        has website "https://example.invalid/projojo-portfolio-archived-source",
        has isArchived true;

    $project isa project,
        has id "40000000-0000-4000-8000-000000000001",
        has name "E2E Infrastructure Proof Project",
        has description "Neutraal publiek project dat alleen de lokale testinfrastructuur bewijst.",
        has imagePath "default.svg",
        has createdAt 2026-01-15T09:00:00.000+0000,
        has location "Arnhem",
        has isPublic true,
        has impactSummary "PROJOJO_E2E_INFRASTRUCTURE_V1",
        has startDate 2026-01-15T09:00:00.000+0000,
        has endDate 2030-01-15T09:00:00.000+0000;

    $task isa task,
        has id "50000000-0000-4000-8000-000000000001",
        has name "Infrastructure Proof Task",
        has description "Neutrale taak voor het bewijzen van dashboard- en public-discovery data.",
        has totalNeeded 2,
        has createdAt 2026-01-15T09:15:00.000+0000,
        has startDate 2026-01-15T09:15:00.000+0000,
        has endDate 2030-01-15T09:15:00.000+0000;

    $portfolio_archived_source_project isa project,
        has id "40000000-0000-4000-8000-000000000002",
        has name "Portfolio Archived Source Project",
        has description "Gearchiveerd bronproject voor portfolio-evidence die zichtbaar blijft.",
        has imagePath "default.svg",
        has createdAt 2026-01-18T09:00:00.000+0000,
        has location "Arnhem",
        has isArchived true,
        has isPublic false,
        has impactSummary "Portfolio archived source fixture",
        has startDate 2026-01-18T09:00:00.000+0000,
        has endDate 2026-02-26T17:00:00.000+0000;

    $portfolio_archived_source_task isa task,
        has id "50000000-0000-4000-8000-000000000002",
        has name "Portfolio Archived Source Task",
        has description "Bron taak voor gearchiveerde portfolio-context.",
        has totalNeeded 1,
        has createdAt 2026-01-18T09:15:00.000+0000,
        has startDate 2026-01-18T09:15:00.000+0000,
        has endDate 2026-02-26T17:00:00.000+0000;

    $pf_task_004_accepted_start_task isa task,
        has id "50000000-0000-4000-8000-000000000010",
        has name "PF-task-004 Accepted Start Task",
        has description "Accepted registration fixture for valid start lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:00:00.000+0000,
        has startDate 2026-01-21T09:00:00.000+0000,
        has endDate 2030-01-21T09:00:00.000+0000;

    $pf_task_004_pending_start_task isa task,
        has id "50000000-0000-4000-8000-000000000011",
        has name "PF-task-004 Pending Start Task",
        has description "Pending registration fixture for rejected start lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:01:00.000+0000,
        has startDate 2026-01-21T09:01:00.000+0000,
        has endDate 2030-01-21T09:01:00.000+0000;

    $pf_task_004_rejected_start_task isa task,
        has id "50000000-0000-4000-8000-000000000012",
        has name "PF-task-004 Rejected Start Task",
        has description "Rejected registration fixture for rejected start lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:02:00.000+0000,
        has startDate 2026-01-21T09:02:00.000+0000,
        has endDate 2030-01-21T09:02:00.000+0000;

    $pf_task_004_started_start_task isa task,
        has id "50000000-0000-4000-8000-000000000013",
        has name "PF-task-004 Started Start Task",
        has description "Already-started registration fixture for rejected start lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:03:00.000+0000,
        has startDate 2026-01-21T09:03:00.000+0000,
        has endDate 2030-01-21T09:03:00.000+0000;

    $pf_task_004_completed_start_task isa task,
        has id "50000000-0000-4000-8000-000000000014",
        has name "PF-task-004 Completed Start Task",
        has description "Already-completed registration fixture for rejected start lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:04:00.000+0000,
        has startDate 2026-01-21T09:04:00.000+0000,
        has endDate 2030-01-21T09:04:00.000+0000;

    $pf_task_004_accepted_completion_task isa task,
        has id "50000000-0000-4000-8000-000000000015",
        has name "PF-task-004 Accepted Completion Task",
        has description "Accepted but not started registration fixture for completion rejection coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:05:00.000+0000,
        has startDate 2026-01-21T09:05:00.000+0000,
        has endDate 2030-01-21T09:05:00.000+0000;

    $pf_task_004_started_completion_task isa task,
        has id "50000000-0000-4000-8000-000000000016",
        has name "PF-task-004 Started Completion Task",
        has description "Started registration fixture for valid completion lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:06:00.000+0000,
        has startDate 2026-01-21T09:06:00.000+0000,
        has endDate 2030-01-21T09:06:00.000+0000;

    $pf_task_004_student_denied_task isa task,
        has id "50000000-0000-4000-8000-000000000017",
        has name "PF-task-004 Student Denied Task",
        has description "Started registration fixture for student lifecycle mutation denial coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:07:00.000+0000,
        has startDate 2026-01-21T09:07:00.000+0000,
        has endDate 2030-01-21T09:07:00.000+0000;

    $pf_task_004_supervisor_denied_task isa task,
        has id "50000000-0000-4000-8000-000000000018",
        has name "PF-task-004 Supervisor Denied Task",
        has description "Started registration fixture for unrelated-supervisor lifecycle denial coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:08:00.000+0000,
        has startDate 2026-01-21T09:08:00.000+0000,
        has endDate 2030-01-21T09:08:00.000+0000;

    $pf_task_004_timeline_task isa task,
        has id "50000000-0000-4000-8000-000000000019",
        has name "PF-task-004 Timeline Access Task",
        has description "Accepted registration fixture for lifecycle timeline access coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:09:00.000+0000,
        has startDate 2026-01-21T09:09:00.000+0000,
        has endDate 2030-01-21T09:09:00.000+0000;

    $pf_task_004_started_revert_task isa task,
        has id "50000000-0000-4000-8000-000000000020",
        has name "PF-task-004 Started Revert Task",
        has description "Started registration fixture for valid revert-start lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:10:00.000+0000,
        has startDate 2026-01-21T09:10:00.000+0000,
        has endDate 2030-01-21T09:10:00.000+0000;

    $pf_task_004_completed_revert_task isa task,
        has id "50000000-0000-4000-8000-000000000021",
        has name "PF-task-004 Completed Revert Task",
        has description "Completed registration fixture for valid revert-completion lifecycle coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:11:00.000+0000,
        has startDate 2026-01-21T09:11:00.000+0000,
        has endDate 2030-01-21T09:11:00.000+0000;

    $pf_task_004_supervisor_start_task isa task,
        has id "50000000-0000-4000-8000-000000000022",
        has name "PF-task-004 Supervisor Start Task",
        has description "Accepted registration fixture for related-supervisor start coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:12:00.000+0000,
        has startDate 2026-01-21T09:12:00.000+0000,
        has endDate 2030-01-21T09:12:00.000+0000;

    $pf_task_004_supervisor_completion_task isa task,
        has id "50000000-0000-4000-8000-000000000023",
        has name "PF-task-004 Supervisor Completion Task",
        has description "Started registration fixture for related-supervisor completion coverage.",
        has totalNeeded 1,
        has createdAt 2026-01-21T09:13:00.000+0000,
        has startDate 2026-01-21T09:13:00.000+0000,
        has endDate 2030-01-21T09:13:00.000+0000;

    $skill isa skill,
        has id "60000000-0000-4000-8000-000000000001",
        has name "Deterministisch Testen",
        has isPending false,
        has createdAt 2026-01-15T09:30:00.000+0000;

    # Required relations
    $manages isa manages (supervisor: $supervisor, business: $business),
        has location "Arnhem";

    $portfolio_unrelated_manages isa manages (supervisor: $portfolio_unrelated_supervisor, business: $portfolio_unrelated_business),
        has location "Nijmegen";

    $has_projects isa hasProjects (business: $business, project: $project);

    $contains_task isa containsTask (project: $project, task: $task);

    $pf_task_004_contains_accepted_start isa containsTask (project: $project, task: $pf_task_004_accepted_start_task);

    $pf_task_004_contains_pending_start isa containsTask (project: $project, task: $pf_task_004_pending_start_task);

    $pf_task_004_contains_rejected_start isa containsTask (project: $project, task: $pf_task_004_rejected_start_task);

    $pf_task_004_contains_started_start isa containsTask (project: $project, task: $pf_task_004_started_start_task);

    $pf_task_004_contains_completed_start isa containsTask (project: $project, task: $pf_task_004_completed_start_task);

    $pf_task_004_contains_accepted_completion isa containsTask (project: $project, task: $pf_task_004_accepted_completion_task);

    $pf_task_004_contains_started_completion isa containsTask (project: $project, task: $pf_task_004_started_completion_task);

    $pf_task_004_contains_student_denied isa containsTask (project: $project, task: $pf_task_004_student_denied_task);

    $pf_task_004_contains_supervisor_denied isa containsTask (project: $project, task: $pf_task_004_supervisor_denied_task);

    $pf_task_004_contains_timeline isa containsTask (project: $project, task: $pf_task_004_timeline_task);

    $pf_task_004_contains_started_revert isa containsTask (project: $project, task: $pf_task_004_started_revert_task);

    $pf_task_004_contains_completed_revert isa containsTask (project: $project, task: $pf_task_004_completed_revert_task);

    $pf_task_004_contains_supervisor_start isa containsTask (project: $project, task: $pf_task_004_supervisor_start_task);

    $pf_task_004_contains_supervisor_completion isa containsTask (project: $project, task: $pf_task_004_supervisor_completion_task);

    $requires_skill isa requiresSkill (task: $task, skill: $skill);

    $pf_task_004_requires_skill_accepted_start isa requiresSkill (task: $pf_task_004_accepted_start_task, skill: $skill);

    $pf_task_004_requires_skill_pending_start isa requiresSkill (task: $pf_task_004_pending_start_task, skill: $skill);

    $pf_task_004_requires_skill_rejected_start isa requiresSkill (task: $pf_task_004_rejected_start_task, skill: $skill);

    $pf_task_004_requires_skill_started_start isa requiresSkill (task: $pf_task_004_started_start_task, skill: $skill);

    $pf_task_004_requires_skill_completed_start isa requiresSkill (task: $pf_task_004_completed_start_task, skill: $skill);

