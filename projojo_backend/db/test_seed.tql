    $pf_task_004_requires_skill_started_completion isa requiresSkill (task: $pf_task_004_started_completion_task, skill: $skill);

    $pf_task_004_requires_skill_student_denied isa requiresSkill (task: $pf_task_004_student_denied_task, skill: $skill);

    $pf_task_004_requires_skill_supervisor_denied isa requiresSkill (task: $pf_task_004_supervisor_denied_task, skill: $skill);

    $pf_task_004_requires_skill_timeline isa requiresSkill (task: $pf_task_004_timeline_task, skill: $skill);

    $pf_task_004_requires_skill_started_revert isa requiresSkill (task: $pf_task_004_started_revert_task, skill: $skill);

    $pf_task_004_requires_skill_completed_revert isa requiresSkill (task: $pf_task_004_completed_revert_task, skill: $skill);

    $pf_task_004_requires_skill_supervisor_start isa requiresSkill (task: $pf_task_004_supervisor_start_task, skill: $skill);

    $pf_task_004_requires_skill_supervisor_completion isa requiresSkill (task: $pf_task_004_supervisor_completion_task, skill: $skill);

    $portfolio_archived_source_has_projects isa hasProjects (business: $portfolio_archived_source_business, project: $portfolio_archived_source_project);

    $portfolio_archived_source_contains_task isa containsTask (project: $portfolio_archived_source_project, task: $portfolio_archived_source_task);

    $portfolio_archived_source_requires_skill isa requiresSkill (task: $portfolio_archived_source_task, skill: $skill);

    $creates_project isa creates (supervisor: $supervisor, project: $project),
        has createdAt 2026-01-15T09:00:00.000+0000;

    $portfolio_registration isa registersForTask (student: $student, task: $task),
        has id "pf-seed-registration-completed",
        has description "Completed deterministic portfolio source registration.",
        has isAccepted true,
        has response "Accepted for deterministic portfolio seed coverage.",
        has createdAt 2026-01-16T09:00:00.000+0000,
        has requestedAt 2026-01-16T09:00:00.000+0000,
        has acceptedAt 2026-01-17T09:00:00.000+0000,
        has startedAt 2026-01-20T09:00:00.000+0000,
        has completedAt 2026-02-20T17:00:00.000+0000;

